{
  "name": "rohamgram-messenger",
  "version": "1.1.1",
  "private": true,
  "description": "پیام‌رسان وب شبیه تلگرام با قابلیت چت خصوصی، گروه، کانال، ارسال فایل/صوت و نوتیفیکیشن زنده | A Telegram-like web messenger",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node scripts/seed.js",
    "test": "node scripts/smoke-test.js",
    "test:socket": "node scripts/rt-test.js",
    "test:ui": "node scripts/ui-test.js",
    "test:e2e": "node scripts/e2e-test.js",
    "test:auth": "node scripts/auth-test.js",
    "test:all": "npm test && npm run test:socket && npm run test:ui && npm run test:e2e && npm run test:auth"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "messenger",
    "chat",
    "telegram",
    "telegram-like",
    "socket.io",
    "websocket",
    "express",
    "sqlite",
    "railway",
    "realtime",
    "persian",
    "rtl",
    "pwa"
  ],
  "author": "You",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie": "^0.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
